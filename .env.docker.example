# Use a freshly generated hexadecimal password; keep the actual file out of Git.
POSTGRES_PASSWORD=
# Local Docker trial. For an actual server use NODE_ENV=production,
# COOKIE_SECURE=true and an https:// APP_ORIGIN behind your reverse proxy.
APP_ORIGIN=http://localhost:3001
PORT=3001
COOKIE_SECURE=false
NODE_ENV=development
TRUST_PROXY=0
REGISTRATION_ENABLED=true
REGISTRATION_INVITE_CODE=
